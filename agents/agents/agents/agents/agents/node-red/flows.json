[
  {
    "id": "flow_energy",
    "type": "tab",
    "label": "Energy alerts",
    "disabled": false,
    "info": ""
  },
  {
    "id": "mqtt_broker",
    "type": "mqtt-broker",
    "name": "Mosquitto local",
    "broker": "127.0.0.1",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "mqtt_in_decision",
    "type": "mqtt in",
    "z": "flow_energy",
    "name": "Coordinator decisions",
    "topic": "energy/coordinator/decision",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 170,
    "y": 140,
    "wires": [["fn_grid_alert"]]
  },
  {
    "id": "fn_grid_alert",
    "type": "function",
    "z": "flow_energy",
    "name": "Grid import alert",
    "func": "var d = msg.payload;\nif (typeof d === \"string\") { d = JSON.parse(d); }\nif (d.grid_import_kw > 0) {\n    msg.payload = JSON.stringify({\n        text: \"ALERT: grid import \" + d.grid_import_kw + \" kW at hour \" + d.hour,\n        hour: d.hour,\n        grid_kw: d.grid_import_kw\n    });\n    return msg;\n}\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 140,
    "wires": [["mqtt_out_alert", "debug_alert"]]
  },
  {
    "id": "mqtt_out_alert",
    "type": "mqtt out",
    "z": "flow_energy",
    "name": "Publish alert to dashboard",
    "topic": "energy/alerts/grid",
    "qos": "",
    "retain": "",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "mqtt_broker",
    "x": 680,
    "y": 110,
    "wires": []
  },
  {
    "id": "debug_alert",
    "type": "debug",
    "z": "flow_energy",
    "name": "Alert log",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 680,
    "y": 170,
    "wires": []
  }
]